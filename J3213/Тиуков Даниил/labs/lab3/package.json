{
  "name": "travel-planner-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TripPlanner SPA на Vue 3 + json-server — ЛР3",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "concurrently -k -n server,vite -c green,cyan \"npm:server\" \"npm:dev\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^8.2.2",
    "json-server": "^0.17.4",
    "vite": "^5.4.10"
  }
}
